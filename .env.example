# --- Database (Turso / libSQL) ---
# For local dev without Turso, use a local SQLite file:
#   TURSO_DATABASE_URL=file:local.db
# For Turso, use the libsql:// URL and an auth token:
#   TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
#   TURSO_AUTH_TOKEN=eyJ...
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# --- Auth.js ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Seed admin (used by `pnpm db:seed`) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-please

# --- Public site flags ---
# Show "confirm before publishing" helper notes next to placeholder copy
NEXT_PUBLIC_SHOW_PLACEHOLDER_NOTES=true

# Canonical site URL used for metadata, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=http://localhost:3000
